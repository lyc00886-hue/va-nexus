  "teacherUse": {
    "howTo": [
      "印出或喺 app 開空白大綱，學生按主題填四件位。",
      "先定主題同四件弧線，再逐件選類型（藝術作品／評賞研究）。",
      "研究工作簿跟 Steps 1–6 提示填；詳細欄位用 sba-guide。",
      "檢查：最少一件藝術作品；四件有推進，唔好四件重複同一稿。"
    ],
    "doNot": [
      "唔好貼上或改寫高分學生卷／示例 PDF 內容。",
      "唔好標 SEN／診斷標籤。",
      "唔好當呢份係完整 guide 欄位重寫。"
    ]
  }

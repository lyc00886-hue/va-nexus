{
 "version": 1,
 "stages": [
  {
   "id": "describe",
   "zh": "字面描述",
   "en": "Literal Description",
   "goal": "Say objectively what you see, without judging.",
   "frames": [
    "This work is a ____ (type) made in ____ (medium), about ____ in size.",
    "The picture mainly depicts ____, placed in the ____ (foreground / middle ground / background).",
    "The artist uses a ____ colour scheme, mainly ____.",
    "____ lines / brushstrokes / textures can be seen in the picture."
   ],
   "checklist": [
    "Medium and materials",
    "Theme / subject matter",
    "Colour",
    "Line and shape",
    "Position in space"
   ]
  },
  {
   "id": "analyse",
   "zh": "形式分析",
   "en": "Formal Analysis",
   "goal": "Explain how the elements and principles organise the picture.",
   "frames": [
    "The artist uses a ____ composition to lead the eye from ____ to ____.",
    "____ and ____ form a strong contrast, emphasising ____.",
    "The repeated ____ creates a ____ sense of rhythm.",
    "Large areas of blank / negative space give the picture a ____ effect."
   ],
   "checklist": [
    "Composition",
    "Contrast",
    "Balance",
    "Rhythm and repetition",
    "Focal point",
    "Space and proportion"
   ]
  },
  {
   "id": "interpret",
   "zh": "詮釋",
   "en": "Interpretation",
   "goal": "Infer meaning, emotion and context.",
   "frames": [
    "I think the work expresses ____, because ____ (cite visual evidence).",
    "The ____ colours create a ____ mood, which reminds us of ____.",
    "Considering the artist's ____ (era / cultural context), the work may reflect ____.",
    "The ____ in the work can be seen as a symbol of ____."
   ],
   "checklist": [
    "Theme and ideas",
    "Emotional mood",
    "Symbolism",
    "Context of creation",
    "Must be supported by visual evidence"
   ]
  },
  {
   "id": "judge",
   "zh": "價值判斷",
   "en": "Value Judgment",
   "goal": "Judge how successful the work is, with reasons, and link it to your own art-making.",
   "frames": [
    "The work succeeds / fails in ____, because ____.",
    "Compared with ____ (another artist), this work is more ____ in terms of ____.",
    "The value of the work lies in ____, and it inspires ____.",
    "In my own SBA I will borrow ____ (composition / concept / technique), rather than imitating the artist's style."
   ],
   "checklist": [
    "Clear criteria for judgement",
    "Arguments for and against",
    "Comparison with other works",
    "Link to your own art-making"
   ]
  }
 ],

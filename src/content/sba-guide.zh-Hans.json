{
  "version": 1,
  "id": "sba-self-guide",
  "note": "Non-AI formative self-review for SBA steps. Not official marks. 非 AI 进展性自评，不是正式分数。",
  "steps": [
    {
      "id": 1,
      "key": "theme",
      "title": "主题探索",
      "checklist": [
        {
          "id": "th-c1",
          "text": "主题由我自己的经历或关注出发，不是直接抄网上题目。"
        },
        {
          "id": "th-c2",
          "text": "写了 3 至 5 个我真正关心的题目，每个都有一句“为什么与我有关”。"
        },
        {
          "id": "th-c3",
          "text": "有主题思维导图，延伸到物件、地方、人物、情绪和社会议题。"
        },
        {
          "id": "th-c4",
          "text": "四件作品有清晰推进（例如个人 → 人际 → 社会╱文化 → 反思╱出路）。"
        },
        {
          "id": "th-c5",
          "text": "有至少 3 张自己拍摄或速写的一手素材。"
        },
        {
          "id": "th-c6",
          "text": "初步列出 1 至 3 位可能参考的艺术家，和我想试的媒介。"
        },
        {
          "id": "th-c7",
          "text": "主题范围与时间、物料可行，已与老师谈过或准备谈。"
        }
      ],
      "guidingQuestions": [
        "这个主题和我哪段真实经历最有关？",
        "如果主题太大，我可以怎样收窄到个人角度？",
        "四件作品之间，下一件怎样回应上一件？",
        "我有哪些一手相片或速写可以支撑主题？",
        "观众一眼见到关键字，会不会明白我关心什么？",
        "我想试的媒介，是否配合主题要表达的感受？"
      ],
      "sentenceFrames": [
        "我选择这个主题，是因为我曾经＿＿，令我感到＿＿。",
        "作品一会表达我自己＿＿的感受╱经历；作品二会延伸到我和＿＿之间的关系。",
        "主题关键字包括＿＿、＿＿和＿＿，全部都连回我＿＿的经历。",
        "四部曲的推进是：个人＿＿ → 人际＿＿ → 社会╱文化＿＿ → 反思╱出路＿＿。"
      ],
      "tip": "主题不必“伟大”，真实并可以发展成四件作品才最重要。",
      "redFlagReminders": [
        {
          "id": "rf1",
          "text": "不要用生硬套话写主题简介；用自己语气讲经历和感受。"
        },
        {
          "id": "rf4",
          "text": "主题不可以只是文字口号；要对应之后会用的具体视觉元素。"
        },
        {
          "id": "rf2",
          "text": "不要只有网上图片；要有自己拍摄或绘画的一手素材。"
        }
      ]
    },
    {
      "id": 2,
      "key": "research",
      "title": "参考研究",
      "checklist": [
        {
          "id": "re-c1",
          "text": "有一手资料（拍摄、写生、问卷或访问）和二手资料，并注明出处。"
        },
        {
          "id": "re-c2",
          "text": "选了至少两位参考艺术家，最好来自不同文化。"
        },
        {
          "id": "re-c3",
          "text": "每位艺术家都有费德曼四步分析，评价有画面证据。"
        },
        {
          "id": "re-c4",
          "text": "每位艺术家有“亲手试”小练习相片。"
        },
        {
          "id": "re-c5",
          "text": "写了“我学到什么”和“我决定舍弃什么、为什么”。"
        },
        {
          "id": "re-c6",
          "text": "研究知识有连回自己创作，不是只抄生平。"
        },
        {
          "id": "re-c7",
          "text": "所有图片和文字资料都有完整来源列表。"
        }
      ],
      "guidingQuestions": [
        "这位艺术家哪个手法最可以转化到我的主题？",
        "我舍弃了什么表面风格，为什么不适合我？",
        "一手资料怎样改变了我原本的意念？",
        "跨文化比较之后，两者表达同一感受有什么不同？",
        "我的评价有没有指出画面中的具体证据？",
        "如果只是模仿表面，观众会怎样看穿？"
      ],
      "sentenceFrames": [
        "我从＿＿学到＿＿，可以用来表达我主题中的＿＿。",
        "＿＿不适合我的作品，因为＿＿。",
        "我认为作品表达了＿＿，因为＿＿（视觉证据）。",
        "我会借鉴＿＿的＿＿手法，而不是模仿其画风。",
        "一手资料显示＿＿，这启发我在画面中加入＿＿。"
      ],
      "tip": "研究要“转化”不是“剪贴”：每位艺术家都要写学到和舍弃什么。",
      "redFlagReminders": [
        {
          "id": "rf1",
          "text": "大段文字像网上或 AI 生成＝红旗；要用自己语气，并注明出处。"
        },
        {
          "id": "rf4",
          "text": "不要只贴作品图；每个判断都要连回形式要素和主题。"
        },
        {
          "id": "rf2",
          "text": "“亲手试”一定要有真实练习证据，不可以事后补做空话。"
        }
      ]
    },
    {
      "id": 3,
      "key": "sketch",
      "title": "草图发展",
      "checklist": [
        {
          "id": "sk-c1",
          "text": "有概念图，连接关键字、一手素材和艺术家手法。"
        },
        {
          "id": "sk-c2",
          "text": "有至少三个真正不同的构图方案（视点、比例、主体或媒介有变）。"
        },
        {
          "id": "sk-c3",
          "text": "每个方案都写了优点和缺点。"
        },
        {
          "id": "sk-c4",
          "text": "落选方案打了 ×，并写清楚放弃原因。"
        },
        {
          "id": "sk-c5",
          "text": "最终选择有理据，连回主题传意和视觉焦点。"
        },
        {
          "id": "sk-c6",
          "text": "草图看得出第二步研究的影响。"
        },
        {
          "id": "sk-c7",
          "text": "没有删走落选草图；发展过程完整保留。"
        }
      ],
      "guidingQuestions": [
        "观众第一眼应该看到什么？",
        "哪个物件或符号最能代表我的主题？",
        "我想观众有什么感受？哪种色彩、线条或肌理可以做到？",
        "我从参考艺术家借了什么手法？怎样变成我自己的？",
        "如果换视点、比例或媒介，效果会不会更好？",
        "我淘汰方案的原因，是否与视觉效果和主题有关，而不是只说“不好看”？"
      ],
      "sentenceFrames": [
        "优点：＿＿；缺点：＿＿。",
        "× 方案＿＿：因为＿＿（例如画面太杂乱、主题不突出）。",
        "我选择方案＿＿，因为它能以＿＿表达＿＿。",
        "这个方案借用了＿＿的＿＿手法，但我改为＿＿。",
        "如果放大主体／改变视点，画面焦点会变成＿＿。"
      ],
      "tip": "落选草图是探索证据；打 × 写原因，千万不要删。",
      "redFlagReminders": [
        {
          "id": "rf2",
          "text": "草图和定稿一模一样、像事后补画＝过程空洞红旗。"
        },
        {
          "id": "rf3",
          "text": "只有一个方案、没有比较筛选，等于没有真正探索。"
        },
        {
          "id": "rf4",
          "text": "草图要讲清楚怎样用视觉元素表达主题，不可以与研究脱节。"
        }
      ]
    },
    {
      "id": 4,
      "key": "media",
      "title": "媒材试验",
      "checklist": [
        {
          "id": "md-c1",
          "text": "每件作品至少有三种物料╱技法试验。"
        },
        {
          "id": "md-c2",
          "text": "每次试验只改一个变项（物料、比例、工具、底材等）。"
        },
        {
          "id": "md-c3",
          "text": "每个试验有相片或样本，并标示所用物料。"
        },
        {
          "id": "md-c4",
          "text": "有至少一个失败或不理想试验，写了原因。"
        },
        {
          "id": "md-c5",
          "text": "写了下一步会改什么，再测。"
        },
        {
          "id": "md-c6",
          "text": "试验问题连回主题（例如“哪种效果最能表达＿＿”）。"
        },
        {
          "id": "md-c7",
          "text": "有总结：选用哪种做法，和它怎样帮助表达主题。"
        },
        {
          "id": "md-c8",
          "text": "最终作品物料和试验纪录对得上。"
        }
      ],
      "guidingQuestions": [
        "这次试验想解决哪个视觉问题？",
        "哪个变项我改了？结果怎样变？",
        "失败试验教了我什么？下一步改什么？",
        "哪种效果最能表达主题中的情绪或概念？",
        "我是不是只问“哪个好看”，而不问“哪个合主题”？",
        "如果全部一次成功，我是不是真的有探索？"
      ],
      "sentenceFrames": [
        "这次试验想解决：＿＿。我改变了＿＿。",
        "结果是＿＿，看起来＿＿；成功╱失败是因为＿＿。",
        "下次我会改为＿＿，看看能否＿＿。",
        "这种效果能表达我主题中的＿＿。",
        "比较过＿＿种做法后，我选用＿＿，因为＿＿。"
      ],
      "tip": "像做科学实验：一次改一个变项，失败一样要拍下来。",
      "redFlagReminders": [
        {
          "id": "rf3",
          "text": "零失败纪录＝红旗；每件作品至少补一个对比小测试。"
        },
        {
          "id": "rf2",
          "text": "试验只有文字没有相片，或者像事后补做，都是过程空洞。"
        },
        {
          "id": "rf4",
          "text": "试验要连主题：不是乱试物料，而是找最适合表达＿＿的做法。"
        }
      ]
    },
    {
      "id": 5,
      "key": "making",
      "title": "作品制作",
      "checklist": [
        {
          "id": "mk-c1",
          "text": "有起点和各阶段过程相片（app 至少 2 张；建议更多）。"
        },
        {
          "id": "mk-c2",
          "text": "有“问题 → 原因 → 解决方法”纪录。"
        },
        {
          "id": "mk-c3",
          "text": "装置╱数码╱立体╱混合媒介有结构相片或图层截图（建议至少五张）。"
        },
        {
          "id": "mk-c4",
          "text": "成品照清晰；立体多角度；动画╱多媒体有分镜。"
        },
        {
          "id": "mk-c5",
          "text": "创作说明用自己语气，每个概念对应一个具体视觉元素。"
        },
        {
          "id": "mk-c6",
          "text": "创作说明提及参考艺术家影响，和媒介选择原因。"
        },
        {
          "id": "mk-c7",
          "text": "作品看得出研究、草图和试验的延续。"
        },
        {
          "id": "mk-c8",
          "text": "已注明资料出处和有没有用过 AI 工具协助。"
        }
